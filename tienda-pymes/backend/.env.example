+# Copiar este archivo como .env y ajustar. NUNCA subir el .env a Git.
PORT=3000
DB_NAME=tienda_pymes

# Base local:
MONGODB_URI=mongodb://127.0.0.1:27017/tienda_pymes

# MongoDB Atlas (el Rol 2 entrega el string; reemplazar USUARIO y CLAVE):
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/tienda_pymes?retryWrites=true&w=majority
