{
  "roles": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "nombre",
          "permisos"
        ],
        "properties": {
          "nombre": {
            "bsonType": "string"
          },
          "descripcion": {
            "bsonType": "string"
          },
          "permisos": {
            "bsonType": "array",
            "items": {
              "bsonType": "string"
            }
          }
        }
      }
    },
    "indexes": [
      {
        "keys": {
          "nombre": 1
        },
        "options": {
          "unique": true
        }
      }
    ]
  },
  "usuarios": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "correo",
          "passwordHash",
          "rolId",
          "estado",
          "creadoEn"
        ],
        "properties": {
          "correo": {
            "bsonType": "string",
            "pattern": "^.+@.+\\..+$"
          },
          "passwordHash": {
            "bsonType": "string"
          },
          "rolId": {
            "bsonType": "objectId"
          },
          "estado": {
            "enum": [
              "ACTIVO",
              "INACTIVO",
              "BLOQUEADO"
            ]
          },
          "creadoEn": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "keys": {
          "correo": 1
        },
        "options": {
          "unique": true,
          "name": "ux_usuarios_correo"
        }
      }
    ]
  },
